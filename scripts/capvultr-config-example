# CAPVULTR example configuration. Copy it, fill in the values, then:
#   source scripts/capvultr-config-example
#   clusterctl generate cluster <name> --flavor <flavor> | kubectl apply -f -
#
# Plans and regions: GET /v2/plans, /v2/plans-metal and /v2/regions.
export CLUSTER_NAME="capvultr-quickstart"
export KUBERNETES_VERSION="v1.34.3"
export REGION="<region>"
export SSH_KEY_ID="<ssh key id>"
export VPC_ID=""                         # leave empty for public IPs only; set to put every node in the VPC

# Cloud compute control plane and workers (all flavors except bare-metal-cp)
export CONTROL_PLANE_MACHINE_COUNT=1
export CONTROL_PLANE_PLAN_ID="<cloud plan id>"
export WORKER_MACHINE_COUNT=1
export WORKER_PLAN_ID="<cloud plan id>"
export MACHINE_IMAGE="<snapshot id of a Cluster API image>"

# Bare metal (bare-metal, bare-metal-cp and bare-metal-standalone flavors)
export BARE_METAL_WORKER_MACHINE_COUNT=1
export BARE_METAL_PLAN_ID="<bare metal plan id>"
export BARE_METAL_OS_ID=2284             # Ubuntu 24.04, the only OS the install script covers
export BARE_METAL_CONTROL_PLANE_PLAN_ID="<bare metal plan id>"   # bare-metal-cp only
